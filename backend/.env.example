# 공공데이터포털 인증키 (마이페이지 → 일반 인증키 Decoding)
# 배출 규칙·재활용센터·의류수거함·구청별 쓰레기통 API에 공통으로 사용
HOUSEHOLD_WASTE_SERVICE_KEY=
# 기후에너지환경부 분리배출 정보조회 서비스 (배출품목 찾기)
WASTE_ITEM_SERVICE_KEY=
# 서버 포트 (Render 등 배포 환경에서는 자동으로 지정됨)
PORT=4000
# 쓰레기통 신고 저장소 (Supabase). 비워 두면 신고를 로컬 파일(data/reports.json, uploads/)에 저장
# Project Settings → API Keys의 Secret key(또는 service_role). 외부에 노출하지 말 것
SUPABASE_URL=
SUPABASE_SECRET_KEY=
